@@ -0,0 +1,54 @@
+#!/bin/bash
+#
+# run-femon.sh — boot a VM with a ConfZNS++ ZNS SSD instrumented for femonitor
+#
+# Geometry: 32 GiB, 128 MiB zones, 8 channels x 4 ways x 2 planes, page read
+# 65 us, program 450 us, channel transfer 25 us, erase 3 ms.
+#
+# Required:
+#   OSIMGF=<guest OS image, qcow2>
+# Optional:
+#   POLICY=SU|MU4|FU   zone placement (default FU)
+#                      SU = 1 channel x 1 way, MU4 = 4 channels x 1 way,
+#                      FU = 8 channels x 4 ways per zone
+#   BACKFILL=0|1       0 = a read reserves the channel from the moment it is
+#                      scheduled; 1 = transfer-only reservation (default 0)
+#   SMP, MEM           guest vCPUs and memory (default 4, 8G)
+#   SSH_PORT           host port forwarded to guest port 22 (default 8082)
+#   FEMU_CPUS          pin the whole QEMU process with taskset (e.g. 0-31)
+set -eu
+
+DIR=$(cd "$(dirname "$0")" && pwd)
+QEMU=${QEMU:-$DIR/build-femu/qemu-system-x86_64}
+[[ -x $QEMU ]] || { echo "no $QEMU: build first"; exit 1; }
+: "${OSIMGF:?set OSIMGF to the guest OS image}"
+
+case ${POLICY:-FU} in
+  SU)  CPZ=1; WPZ=1 ;;
+  MU4) CPZ=4; WPZ=1 ;;
+  FU)  CPZ=8; WPZ=4 ;;
+  *) echo "POLICY=SU|MU4|FU"; exit 1 ;;
+esac
+
+DEV="-device femu,devsz_mb=32768,namespaces=1,femu_mode=3,queues=64"
+DEV+=",zns_zonesize=134217728,zns_channels=8,zns_channels_per_zone=$CPZ"
+DEV+=",zns_ways=4,zns_ways_per_zone=$WPZ,zns_dies_per_chip=1,zns_planes_per_die=2"
+DEV+=",zns_page_read_latency=65000,zns_page_write_latency=450000"
+DEV+=",zns_channel_transfer_latency=25000,zns_block_erasure_latency=3000000"
+DEV+=",zns_ch_backfill=${BACKFILL:-0}"
+
+REQ_MB=$(( 32768 + $(echo "${MEM:-8G}" | sed 's/G//') * 1024 + 2048 ))
+AVAIL_MB=$(( $(awk '/MemAvailable/ {print $2}' /proc/meminfo) / 1024 ))
+if (( AVAIL_MB < REQ_MB )); then
+    echo "run-femon: ${AVAIL_MB} MB available < ${REQ_MB} MB needed" >&2
+    exit 1
+fi
+
+PIN=(); [[ -n ${FEMU_CPUS:-} ]] && PIN=(taskset -c "$FEMU_CPUS")
+exec ${PIN[@]+"${PIN[@]}"} "$QEMU" -name "CONFZNSPP-FEMON-VM" \
+  -enable-kvm -cpu host -smp "${SMP:-4}" -m "${MEM:-8G}" \
+  -device virtio-scsi-pci,id=scsi0 -device scsi-hd,drive=hd0 \
+  -drive "file=$OSIMGF,if=none,aio=native,cache=none,format=qcow2,id=hd0" \
+  $DEV \
+  -net user,hostfwd=tcp::"${SSH_PORT:-8082}"-:22 -net nic,model=virtio -nographic \
+  -qmp unix:./qmp-sock,server,nowait
