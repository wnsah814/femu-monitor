diff --git a/hw/femu/femon_protocol.h b/hw/femu/femon_protocol.h
new file mode 100644
index 000000000..ecb67fc2d
--- /dev/null
+++ b/hw/femu/femon_protocol.h
@@ -0,0 +1,211 @@
+/*
+ * femon_protocol.h — the femonitor <-> FEMU monitoring protocol
+ *
+ * The single definition included by both the device (femu/hw/femu) and the
+ * host tool (femonitor). The structures here are the wire format of the
+ * admin command payloads, so add or change fields only in this file and
+ * rebuild both sides. Sizes are pinned by _Static_assert.
+ *
+ * Typedef names keep the ones the host tool has always used
+ * (bbssd_*_t / znssd_*_t); new device-side code uses the same names.
+ */
+#ifndef FEMON_PROTOCOL_H
+#define FEMON_PROTOCOL_H
+
+#include <stdint.h>
+
+/* ---------------------------------------------------------- admin opcodes */
+#define NVME_ADM_CMD_FEMON_RESET  0xD4 /* clear all registered cumulative counters
+                                        * and histograms (gauges and state kept) */
+#ifndef FEMON_NO_DEVTYPE_MACRO
+#define NVME_ADM_CMD_DEVTYPE     0xD0  /* device type and geometry */
+#endif
+#define NVME_ADM_CMD_FEMON_SCHEMA 0xD1 /* registry schema (self-describing) */
+#define NVME_ADM_CMD_FEMON_FETCH  0xD2 /* registry values (all or one) */
+#define NVME_ADM_CMD_FEMON_TRACE  0xD3 /* tracepoint histograms on/off
+                                        * cdw11 = 1 (on) / 0 (off),
+                                        * cdw12 = FEMON_SEL_ALL or a metric id */
+
+/* ------------------------------------------------------------ device type */
+typedef uint64_t femon_device_type_t;
+enum {
+    FEMON_DEVICE_BBSSD = 0,
+    FEMON_DEVICE_ZNSSD = 1,
+};
+
+/* ------------------------------------------------- 0xD0: device info */
+typedef struct {
+    femon_device_type_t type;
+    union {
+        struct {
+            int secsz;        int secs_per_pg;  int pgs_per_blk;
+            int blks_per_pl;  int pls_per_lun;  int luns_per_ch;
+            int nchs;         int secs_per_blk; int secs_per_pl;
+            int secs_per_lun; int secs_per_ch;  int tt_secs;
+            int pgs_per_pl;   int pgs_per_lun;  int pgs_per_ch;
+            int tt_pgs;       int blks_per_lun; int blks_per_ch;
+            int tt_blks;      int secs_per_line; int pgs_per_line;
+            int blks_per_line; int tt_lines;    int pls_per_ch;
+            int tt_pls;       int tt_luns;
+        } bbssd;
+        struct {
+            uint64_t num_ch;
+            uint64_t num_lun;
+            uint64_t nr_zones;
+            uint64_t num_planes;     /* total number of planes */
+            uint64_t planes_per_die;
+            uint64_t dies_per_chip;
+        } znssd;
+    };
+} femon_device_info_t;
+
+/* ------------------------------------------------- femonitor view model: BBSSD
+ * Not a wire format. The client rebuilds these from the 0xD2 values of the
+ * bbssd.* metrics and hands them to the views. */
+typedef struct {
+    int curline_id;
+    int ch;
+    int lun;
+    int pg;
+    int blk;
+    int pl;
+} bbssd_write_pointer_info_t;
+
+typedef struct {
+    int id;
+    int ipc;
+    int vpc;
+    uint64_t pos;   /* position in the victim priority queue */
+} bbssd_line_info_t;
+
+typedef struct {
+    bbssd_write_pointer_info_t wp_info;
+    uint64_t gc_count;
+    uint64_t gc_pgs;
+    int tt_lines;
+    int free_line_cnt;
+    int victim_line_cnt;
+    int full_line_cnt;
+} bbssd_monitor_header_t;
+
+/* ------------------------------------------------- femonitor view model: ZNS
+ * Not a wire format. The client rebuilds these from the 0xD2 values of the
+ * zns.* metrics and hands them to the views. */
+typedef struct {
+    uint8_t  zt;    /* zone type */
+    uint8_t  zs;    /* zone state */
+    uint8_t  za;    /* zone attributes */
+    uint64_t zcap;
+    uint64_t zslba;
+    uint64_t wp;
+} znssd_zone_descr_info_t;
+
+typedef struct {
+    znssd_zone_descr_info_t d;
+    uint64_t w_ptr;
+    uint64_t cnt_reset;  /* cumulative resets of this zone */
+} znssd_zone_info_t;
+
+typedef struct {
+    uint64_t total_xfer_count;   /* NAND page transfers */
+    uint64_t conflict_count;
+    uint64_t total_wait_time_ns;
+} znssd_channel_stat_t;
+
+typedef struct {
+    uint64_t total_io_count;
+    uint64_t conflict_count;
+    uint64_t total_wait_time_ns;
+} znssd_plane_stat_t;
+
+typedef struct {
+    uint64_t num_zones;
+    uint64_t zr_count;      /* cumulative zone resets, all zones */
+    uint64_t num_channels;
+    uint64_t num_planes;
+    /* write cache statistics, counted per write command.
+     * hit  : a cache is bound to the request's zone and absorbs it
+     * miss : no cache bound to the zone (including taking a free one)
+     * evict: misses that took another zone's cache and paid its flush
+     * flush: all flushes to NAND (evictions + full caches) */
+    uint64_t wc_hit;
+    uint64_t wc_miss;
+    uint64_t wc_evict;
+    uint64_t wc_flush;
+} znssd_monitor_header_t;
+
+/* ------------------------------------------- 0xD1/0xD2: metric registry
+ *
+ * Registration-based metric protocol with a self-describing payload: the
+ * host first reads the schema with 0xD1 (which metrics exist and how many
+ * values each has), and uses it to size and decode the 0xD2 payload. A
+ * metric newly registered in the device (femon_registry.h) appears in the
+ * schema without any change to the host tool.
+ *
+ * 0xD1 SCHEMA: cdw10 = NUMD (buffer dwords - 1).
+ *   payload = femon_schema_hdr_t + femon_schema_rec_t[count]
+ * 0xD2 FETCH:  cdw10 = NUMD, cdw11 = selector
+ *   (FEMON_SEL_ALL = all, otherwise that one id).
+ *   payload = femon_fetch_hdr_t + { femon_fetch_rec_t + uint64_t[nvals] }*
+ *   version must match the schema generation; if not, the host re-reads. */
+
+#define FEMON_SEL_ALL   0xFFFFFFFFu
+
+enum {
+    FEMON_MT_U64  = 0,   /* cumulative counter or gauge, u64 (scalar or array) */
+    FEMON_MT_HIST = 1,   /* log2 histogram buckets (tracepoints) */
+};
+
+/* FEMON_MT_HIST payload: dims[0] = FEMON_HIST_NVALS u64 values.
+ * The first FEMON_HIST_BUCKETS are log2 buckets in µs (bucket i =
+ * [2^i, 2^(i+1)) µs, i = 0 is [0, 2) µs, the last has no upper bound); the
+ * last 4 are n, sum, min, max in ns (buckets show the order of magnitude,
+ * the statistics keep full precision; the renderer converts). Buckets alone
+ * would put the mean within a factor of 2, so the exact statistics travel
+ * with them. Invariant: sum of buckets == n. */
+#define FEMON_HIST_BUCKETS 16
+#define FEMON_HIST_NVALS   (FEMON_HIST_BUCKETS + 4)
+
+#define FEMON_MAX_DIMS  3
+#define FEMON_NAME_LEN  48   /* including NUL */
+
+typedef struct {
+    uint32_t version;    /* schema generation (bumped on every registration) */
+    uint32_t count;      /* number of records that follow */
+} femon_schema_hdr_t;
+
+typedef struct {
+    uint16_t id;
+    uint8_t  type;                     /* FEMON_MT_* */
+    uint8_t  ndims;                    /* 0 = scalar */
+    uint32_t dims[FEMON_MAX_DIMS];     /* the first ndims are valid */
+    char     name[FEMON_NAME_LEN];     /* NUL-terminated, <subsys>.<obj>.<metric> */
+} femon_schema_rec_t;
+
+typedef struct {
+    uint32_t version;
+    uint32_t count;
+} femon_fetch_hdr_t;
+
+typedef struct {
+    uint16_t id;
+    uint16_t rsvd;
+    uint32_t nvals;      /* uint64_t values that follow (= product of dims) */
+} femon_fetch_rec_t;
+
+/* ------------------------------------------------- pinned wire format */
+_Static_assert(sizeof(bbssd_write_pointer_info_t) == 24, "bb wp_info layout");
+_Static_assert(sizeof(bbssd_line_info_t) == 24, "bb line_info layout");
+_Static_assert(sizeof(bbssd_monitor_header_t) == 56, "bb monitor header layout");
+_Static_assert(sizeof(znssd_zone_descr_info_t) == 32, "zns zone descr layout");
+_Static_assert(sizeof(znssd_zone_info_t) == 48, "zns zone info layout");
+_Static_assert(sizeof(znssd_channel_stat_t) == 24, "zns channel stat layout");
+_Static_assert(sizeof(znssd_plane_stat_t) == 24, "zns plane stat layout");
+_Static_assert(sizeof(znssd_monitor_header_t) == 64, "zns monitor header layout");
+_Static_assert(sizeof(femon_device_info_t) == 112, "device info layout");
+_Static_assert(sizeof(femon_schema_hdr_t) == 8, "femon schema hdr layout");
+_Static_assert(sizeof(femon_schema_rec_t) == 64, "femon schema rec layout");
+_Static_assert(sizeof(femon_fetch_hdr_t) == 8, "femon fetch hdr layout");
+_Static_assert(sizeof(femon_fetch_rec_t) == 8, "femon fetch rec layout");
+
+#endif /* FEMON_PROTOCOL_H */
diff --git a/hw/femu/femon_registry.c b/hw/femu/femon_registry.c
new file mode 100644
index 000000000..af6f457b0
--- /dev/null
+++ b/hw/femu/femon_registry.c
@@ -0,0 +1,233 @@
+/*
+ * femon_registry.c — registration-based monitoring metric registry
+ */
+#include "qemu/osdep.h"
+#include <string.h>
+#include "femon_registry.h"
+
+femon_registry_t *femon_registry_new(void)
+{
+    return g_malloc0(sizeof(femon_registry_t));
+}
+
+static femon_metric_t *femon_alloc_metric(femon_registry_t *reg,
+                                          const char *name)
+{
+    femon_metric_t *m;
+
+    if (reg->count >= FEMON_REG_MAX_METRICS) {
+        return NULL;
+    }
+    m = &reg->m[reg->count];
+    if (strlen(name) >= FEMON_NAME_LEN) {
+        return NULL;
+    }
+    g_strlcpy(m->name, name, sizeof(m->name));
+    reg->count++;
+    reg->version++;
+    return m;
+}
+
+int femon_register_u64(femon_registry_t *reg, const char *name, uint64_t *ptr)
+{
+    femon_metric_t *m = femon_alloc_metric(reg, name);
+
+    if (!m) {
+        return -1;
+    }
+    m->type = FEMON_MT_U64;
+    m->ndims = 0;
+    m->nvals = 1;
+    m->ptr = ptr;
+    return 0;
+}
+
+int femon_register_arr(femon_registry_t *reg, const char *name, uint8_t type,
+                       uint8_t ndims, const uint32_t *dims,
+                       femon_fill_fn fill, void *opaque)
+{
+    femon_metric_t *m;
+    uint32_t nvals = 1;
+    int i;
+
+    if (ndims == 0 || ndims > FEMON_MAX_DIMS || !fill) {
+        return -1;
+    }
+    m = femon_alloc_metric(reg, name);
+    if (!m) {
+        return -1;
+    }
+    m->type = type;
+    m->ndims = ndims;
+    for (i = 0; i < ndims; i++) {
+        m->dims[i] = dims[i];
+        nvals *= dims[i];
+    }
+    m->nvals = nvals;
+    m->fill = fill;
+    m->opaque = opaque;
+    return 0;
+}
+
+void femon_hist_record_slow(femon_hist_t *h, uint64_t ns)
+{
+    uint64_t us = ns / 1000;
+    int idx = us ? (63 - __builtin_clzll(us)) : 0;
+
+    if (idx >= FEMON_HIST_BUCKETS) {
+        idx = FEMON_HIST_BUCKETS - 1;
+    }
+    h->bucket[idx]++;
+    if (h->n == 0 || ns < h->min) {
+        h->min = ns;
+    }
+    if (ns > h->max) {
+        h->max = ns;
+    }
+    h->n++;
+    h->sum += ns;
+}
+
+int femon_register_hist(femon_registry_t *reg, const char *name,
+                        femon_hist_t *h)
+{
+    femon_metric_t *m = femon_alloc_metric(reg, name);
+
+    if (!m) {
+        return -1;
+    }
+    m->type = FEMON_MT_HIST;
+    m->ndims = 1;
+    m->dims[0] = FEMON_HIST_NVALS;
+    m->nvals = FEMON_HIST_NVALS;
+    m->ptr = h->bucket;   /* bucket..max exposed contiguously (see the header) */
+    m->hist = h;
+    return 0;
+}
+
+void femon_registry_trace_ctl(femon_registry_t *reg, uint32_t sel, int enable)
+{
+    uint32_t i;
+
+    for (i = 0; i < reg->count; i++) {
+        if (reg->m[i].hist && (sel == FEMON_SEL_ALL || sel == i)) {
+            reg->m[i].hist->enabled = enable ? 1 : 0;
+        }
+    }
+}
+
+void femon_registry_reset_hists(femon_registry_t *reg)
+{
+    uint32_t i;
+
+    for (i = 0; i < reg->count; i++) {
+        femon_hist_t *h = reg->m[i].hist;
+
+        if (h) {
+            /* keep enabled; zero from bucket through the statistics */
+            memset(h->bucket, 0, sizeof(*h) - offsetof(femon_hist_t, bucket));
+        }
+    }
+}
+
+size_t femon_schema_bytes(const femon_registry_t *reg)
+{
+    return sizeof(femon_schema_hdr_t) +
+           (size_t)reg->count * sizeof(femon_schema_rec_t);
+}
+
+void femon_schema_encode(const femon_registry_t *reg, uint8_t *buf)
+{
+    femon_schema_hdr_t *hdr = (femon_schema_hdr_t *)buf;
+    femon_schema_rec_t *rec = (femon_schema_rec_t *)(buf + sizeof(*hdr));
+    uint32_t i, d;
+
+    hdr->version = reg->version;
+    hdr->count = reg->count;
+    for (i = 0; i < reg->count; i++) {
+        const femon_metric_t *m = &reg->m[i];
+
+        memset(&rec[i], 0, sizeof(rec[i]));
+        rec[i].id = i;
+        rec[i].type = m->type;
+        rec[i].ndims = m->ndims;
+        for (d = 0; d < m->ndims; d++) {
+            rec[i].dims[d] = m->dims[d];
+        }
+        g_strlcpy(rec[i].name, m->name, sizeof(rec[i].name));
+    }
+}
+
+size_t femon_fetch_bytes(const femon_registry_t *reg, uint32_t sel)
+{
+    size_t sz = sizeof(femon_fetch_hdr_t);
+    uint32_t i;
+
+    for (i = 0; i < reg->count; i++) {
+        if (sel != FEMON_SEL_ALL && sel != i) {
+            continue;
+        }
+        sz += sizeof(femon_fetch_rec_t) +
+              (size_t)reg->m[i].nvals * sizeof(uint64_t);
+    }
+    return sz;
+}
+
+void femon_fetch_encode(const femon_registry_t *reg, uint32_t sel,
+                        uint8_t *buf)
+{
+    femon_fetch_hdr_t *hdr = (femon_fetch_hdr_t *)buf;
+    uint8_t *p = buf + sizeof(*hdr);
+    uint32_t i, n = 0;
+
+    for (i = 0; i < reg->count; i++) {
+        const femon_metric_t *m = &reg->m[i];
+        femon_fetch_rec_t *rec;
+        uint64_t *vals;
+
+        if (sel != FEMON_SEL_ALL && sel != i) {
+            continue;
+        }
+        rec = (femon_fetch_rec_t *)p;
+        rec->id = i;
+        rec->rsvd = 0;
+        rec->nvals = m->nvals;
+        vals = (uint64_t *)(p + sizeof(*rec));
+        if (m->ptr) {
+            uint32_t v;
+
+            /* statistics read without synchronizing with the writer: a relaxed
+             * load only stops the compiler from hoisting or caching it (free on x86-64) */
+            for (v = 0; v < m->nvals; v++) {
+                vals[v] = __atomic_load_n(&m->ptr[v], __ATOMIC_RELAXED);
+            }
+        } else {
+            m->fill(m->opaque, vals);
+        }
+        p += sizeof(*rec) + (size_t)m->nvals * sizeof(uint64_t);
+        n++;
+    }
+    hdr->version = reg->version;
+    hdr->count = n;
+}
+
+void femon_registry_set_reset_hook(femon_registry_t *reg,
+                                   void (*hook)(void *), void *opaque)
+{
+    reg->reset_hook = hook;
+    reg->reset_opaque = opaque;
+}
+
+void femon_registry_reset(femon_registry_t *reg)
+{
+    for (uint32_t i = 0; i < reg->count; i++) {
+        femon_metric_t *m = &reg->m[i];
+        if (m->type == FEMON_MT_U64 && m->ptr) {
+            memset(m->ptr, 0, (size_t)m->nvals * sizeof(uint64_t));
+        }
+    }
+    femon_registry_reset_hists(reg);
+    if (reg->reset_hook) {
+        reg->reset_hook(reg->reset_opaque);
+    }
+}
diff --git a/hw/femu/femon_registry.h b/hw/femu/femon_registry.h
new file mode 100644
index 000000000..f940b2d2c
--- /dev/null
+++ b/hw/femu/femon_registry.h
@@ -0,0 +1,105 @@
+/*
+ * femon_registry.h — registration-based monitoring metric registry
+ *
+ * A backend (FTL) registers metrics by name at init; the host tool then
+ * reads their schema and values, self-described, through 0xD1/0xD2
+ * (femon_protocol.h). Exposing a new metric takes one registration line and
+ * no change to the protocol or the host tool.
+ *
+ * Threading: registration happens only in realize (single thread). Queries
+ * read the counters asynchronously from the admin path; for statistics a
+ * torn read is limited to one u64, so no lock is taken.
+ */
+#ifndef FEMON_REGISTRY_H
+#define FEMON_REGISTRY_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include "femon_protocol.h"
+
+#define FEMON_REG_MAX_METRICS 64
+
+/* array or derived metrics: write exactly nvals u64 values to out */
+typedef void (*femon_fill_fn)(void *opaque, uint64_t *out);
+
+/* ---- static tracepoints: in-place log2 histograms ----
+ * Lock-free, assuming a single writer (the one thread that runs the path).
+ * When disabled the cost is one inlined, predictable branch (the "disabled
+ * probe effect ~0" principle of DTrace); recording goes to an out-of-line
+ * slow path so more tracepoints do not pollute the hot-path i-cache.
+ * bucket through max are laid out contiguously and go on the wire as is
+ * (the FEMON_HIST_NVALS layout in femon_protocol.h). */
+typedef struct femon_hist {
+    uint64_t enabled;                        /* switched at run time by 0xD3 */
+    uint64_t bucket[FEMON_HIST_BUCKETS];     /* log2 µs */
+    uint64_t n;                              /* exact statistics below, in ns */
+    uint64_t sum;
+    uint64_t min;
+    uint64_t max;
+} femon_hist_t;
+
+void femon_hist_record_slow(femon_hist_t *h, uint64_t ns);
+
+static inline void femon_hist_record(femon_hist_t *h, uint64_t ns)
+{
+    if (__builtin_expect(!h->enabled, 1)) {
+        return;
+    }
+    femon_hist_record_slow(h, ns);
+}
+
+typedef struct femon_metric {
+    char     name[FEMON_NAME_LEN];
+    uint8_t  type;                  /* FEMON_MT_* */
+    uint8_t  ndims;
+    uint32_t dims[FEMON_MAX_DIMS];
+    uint32_t nvals;                 /* product of dims (scalar = 1) */
+    uint64_t *ptr;                  /* direct view of a contiguous u64 array (or fill) */
+    femon_fill_fn fill;
+    void     *opaque;
+    femon_hist_t *hist;             /* FEMON_MT_HIST: the histogram 0xD3 controls */
+} femon_metric_t;
+
+typedef struct femon_registry {
+    uint32_t version;               /* bumped on every registration: schema generation */
+    uint32_t count;
+    femon_metric_t m[FEMON_REG_MAX_METRICS];
+    /* backend hook for 0xD4 RESET: zeroes scattered counters (e.g. the sources of fill arrays) */
+    void (*reset_hook)(void *opaque);
+    void *reset_opaque;
+} femon_registry_t;
+
+femon_registry_t *femon_registry_new(void);
+
+/* scalar u64 counter: exposed by pointer */
+int femon_register_u64(femon_registry_t *reg, const char *name, uint64_t *ptr);
+
+/* array metric: the fill callback writes nvals (= product of dims) values at query time */
+int femon_register_arr(femon_registry_t *reg, const char *name, uint8_t type,
+                       uint8_t ndims, const uint32_t *dims,
+                       femon_fill_fn fill, void *opaque);
+
+/* histogram: buckets exposed by pointer, and registered for 0xD3 on/off */
+int femon_register_hist(femon_registry_t *reg, const char *name,
+                        femon_hist_t *h);
+
+/* 0xD3: turn on/off the histograms selected by sel (FEMON_SEL_ALL or an id) */
+void femon_registry_trace_ctl(femon_registry_t *reg, uint32_t sel, int enable);
+
+/* zero the buckets of every registered histogram */
+void femon_registry_reset_hists(femon_registry_t *reg);
+
+/* 0xD4 RESET: zero pointer-exposed u64 counters (scalar and array), clear histograms,
+ * and call the backend reset_hook. Fill-callback metrics (gauges, state) are untouched. */
+void femon_registry_reset(femon_registry_t *reg);
+void femon_registry_set_reset_hook(femon_registry_t *reg,
+                                   void (*hook)(void *), void *opaque);
+
+/* 0xD1/0xD2 payload encoding (used by nvme-admin.c) */
+size_t femon_schema_bytes(const femon_registry_t *reg);
+void   femon_schema_encode(const femon_registry_t *reg, uint8_t *buf);
+size_t femon_fetch_bytes(const femon_registry_t *reg, uint32_t sel);
+void   femon_fetch_encode(const femon_registry_t *reg, uint32_t sel,
+                          uint8_t *buf);
+
+#endif /* FEMON_REGISTRY_H */
