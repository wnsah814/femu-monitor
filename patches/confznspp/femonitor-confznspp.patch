+static uint16_t nvme_femon_schema(FemuCtrl *n, NvmeCmd *cmd)
+{
+    uint64_t prp1 = le64_to_cpu(cmd->dptr.prp1), prp2 = le64_to_cpu(cmd->dptr.prp2);
+    uint32_t requested = (le32_to_cpu(cmd->cdw10) + 1) << 2;
+    size_t required; uint8_t *buf; uint16_t ret;
+    if (!n->femon_reg) return NVME_INVALID_OPCODE | NVME_DNR;
+    required = femon_schema_bytes(n->femon_reg);
+    if (requested < required) return NVME_INVALID_FIELD | NVME_DNR;
+    buf = g_malloc0(required); femon_schema_encode(n->femon_reg, buf);
+    ret = dma_read_prp(n, buf, required, prp1, prp2); g_free(buf); return ret;
+}
+static uint16_t nvme_femon_fetch(FemuCtrl *n, NvmeCmd *cmd)
+{
+    uint64_t prp1 = le64_to_cpu(cmd->dptr.prp1), prp2 = le64_to_cpu(cmd->dptr.prp2);
+    uint32_t requested = (le32_to_cpu(cmd->cdw10) + 1) << 2;
+    uint32_t sel = le32_to_cpu(cmd->cdw11);
+    size_t required; uint8_t *buf; uint16_t ret;
+    if (!n->femon_reg) return NVME_INVALID_OPCODE | NVME_DNR;
+    required = femon_fetch_bytes(n->femon_reg, sel);
+    if (requested < required) return NVME_INVALID_FIELD | NVME_DNR;
+    buf = g_malloc0(required); femon_fetch_encode(n->femon_reg, sel, buf);
+    ret = dma_read_prp(n, buf, required, prp1, prp2); g_free(buf); return ret;
+}
+static uint16_t nvme_femon_reset(FemuCtrl *n, NvmeCmd *cmd)
+{
+    (void)cmd;
+    if (!n->femon_reg) return NVME_INVALID_OPCODE | NVME_DNR;
+    femon_registry_reset(n->femon_reg);
+    femu_log("femonitor: monitoring statistics reset\n");
+    return NVME_SUCCESS;
+}
+static uint16_t nvme_femon_trace(FemuCtrl *n, NvmeCmd *cmd)
