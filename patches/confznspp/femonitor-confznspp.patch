+/*
+ * femon backfill model: a read's data-out happens once its page read ends, so it
+ * is booked as a window in the future instead of holding the channel from now.
+ * Every transfer avoids every booked window, so no two transfers share the bus.
+ * Windows that ended before the current command started can no longer be hit.
+ */
+static void zns_bus_prune(zns_ssd_channel *ch, uint64_t now)
+{
+    uint32_t i, j = 0;
+    for (i = 0; i < ch->nres; i++) {
+        if (ch->res[i][1] > now) {
+            ch->res[j][0] = ch->res[i][0];
+            ch->res[j][1] = ch->res[i][1];
+            j++;
+        }
+    }
+    ch->nres = j;
+}
+
+/* earliest s >= start such that [s, s + len) overlaps no booked window */
+static uint64_t zns_bus_fit(const zns_ssd_channel *ch, uint64_t start, uint64_t len)
+{
+    uint32_t i;
+    for (i = 0; i < ch->nres; i++) {
+        if (ch->res[i][1] <= start) {
+            continue;
+        }
+        if (ch->res[i][0] >= start + len) {
+            break;
+        }
+        start = ch->res[i][1];
+    }
+    return start;
+}
+
+static void zns_bus_book(zns_ssd_channel *ch, uint64_t start, uint64_t end)
+{
+    uint32_t i;
+    if (ch->nres == ch->res_cap) {
+        ch->res_cap = ch->res_cap ? 2 * ch->res_cap : 64;
+        ch->res = g_realloc(ch->res, (size_t)ch->res_cap * sizeof(*ch->res));
+    }
+    for (i = ch->nres; i > 0 && ch->res[i - 1][0] > start; i--) {
+        ch->res[i][0] = ch->res[i - 1][0];
+        ch->res[i][1] = ch->res[i - 1][1];
+    }
+    ch->res[i][0] = start;
+    ch->res[i][1] = end;
+    ch->nres++;
+}
